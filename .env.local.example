# Copy to .env.local and fill in. .env.local is gitignored - never commit real values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS - never import from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (photo storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public custom domain bound to the bucket, e.g. https://photos.khuac.com
R2_PUBLIC_URL=

# --- Cloudflare Images (on-the-fly resizing, used from Phase 3) ---
CF_IMAGES_ACCOUNT_HASH=

# --- Google Maps Platform ---
# Restrict by HTTP referrer (khuac.com, localhost) and set a daily quota cap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID enables Cloud-based map styling. Left empty the map falls
# back to Google's DEMO_MAP_ID, which advanced markers work fine with.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
