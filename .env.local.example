# Copy to .env.local and fill in. .env.local is gitignored - never commit real values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS - never import from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (photo storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public custom domain bound to the bucket, e.g. https://photos.khuac.com
R2_PUBLIC_URL=

# --- Cloudflare Images (on-the-fly resizing, used from Phase 3) ---
CF_IMAGES_ACCOUNT_HASH=

# --- Google Maps Platform ---
# Restrict by HTTP referrer (khuac.com, localhost) and set a daily quota cap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID enables Cloud-based map styling. Left empty the map falls
# back to Google's DEMO_MAP_ID, which advanced markers work fine with.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Gemini Developer API (default; Vertex is optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_PROVIDER=developer
# Only for an explicitly chosen Vertex deployment:
# GEMINI_PROVIDER=vertex
# GEMINI_VERTEX_SERVICE_ACCOUNT=
# VERTEX_REGION=global

# --- 지도 레이어 (등산로 / 국토지리) ---
# Thunderforest Outdoors. 서버 전용: 이 키는 도메인 제한을 걸 수 없어서 브라우저에
# 내보내면 누구나 우리 무료 한도(15만 타일/월)를 대신 소모할 수 있습니다. 타일은
# /api/tiles/... 프록시를 거치고 키는 서버에만 둡니다.
THUNDERFOREST_API_KEY=
# 프록시가 설정됐음을 브라우저에 알리는 플래그. 브라우저는 위 키를 볼 수 없으므로
# 레이어 노출 여부를 이것으로 판단합니다. 켜려면 1.
NEXT_PUBLIC_TILE_OUTDOORS=

# VWorld(국토교통부). 발급 시 등록한 도메인에서만 동작하므로 khuac.com과
# localhost를 모두 등록해야 합니다. 개발키는 3개월이고, 만료·도메인 불일치는
# 에러가 아니라 빈 타일로 나타납니다.
NEXT_PUBLIC_VWORLD_API_KEY=
