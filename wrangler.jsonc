{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "khuac-homepage",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"routes": [
		// Declared here rather than clicked in the dashboard so the domain this
		// Worker answers on is part of the repo. Cloudflare creates the DNS
		// record and certificate for the zone on deploy.
		{ "pattern": "khuac.com", "custom_domain": true }
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"vars": {
		// Vertex AI rather than the Gemini Developer API: the Developer API
		// geo-gates on the calling IP, and a Worker's outbound requests leave
		// from whichever colo Cloudflare picks, so the same key was rejected
		// with FAILED_PRECONDITION ("User location is not supported") from
		// production while working from a developer's own machine. Vertex
		// authenticates against a Cloud project instead. Local dev leaves this
		// unset and keeps using GEMINI_API_KEY - see src/lib/gemini/client.ts.
		"GEMINI_PROVIDER": "vertex"
	},
	"services": [
		{
			// Self-reference used by OpenNext's cache revalidation; must match "name" above.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "khuac-homepage"
		}
	],
	"r2_buckets": [
		{
			// Bucket must exist before the first deploy: `wrangler r2 bucket create khuac-homepage-opennext-cache`
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "khuac-homepage-opennext-cache"
		}
		// The photo bucket has no binding on purpose: server-side reads go through
		// R2's S3 API (src/lib/r2/client.ts) so `next dev` and Workers use one path.
		// It needs R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY instead.
	],
	"images": {
		// Powers on-the-fly resizing (thumbnail/preview) instead of sharp - see Phase 3.
		"binding": "IMAGES"
	}
	// Secrets (SUPABASE_SERVICE_ROLE_KEY, R2_SECRET_ACCESS_KEY, ...) are set with
	// `wrangler secret put <NAME>`, not committed here. Non-secret vars go in "vars".
}
